{
  "name": "@hizollo/osu-api",
  "version": "1.2.2",
  "description": "A Node.js library for interacting with osu!api, written in TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node test",
    "type-check": "tsc --noEmit",
    "build": "tsdown",
    "docgen": "npx typedoc index.ts",
    "deploy": "gh-pages -d docs",
    "predeploy": "npm run docgen",
    "prepublishOnly": "npm run build && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HiZollo/osu-api.git"
  },
  "keywords": [
    "HiZollo",
    "osu",
    "osu-api"
  ],
  "author": "HiZollo Dev Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/superagent": "^8.1.11",
    "gh-pages": "^6.3.0",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "superagent": "^10.4.2"
  },
  "overrides": {
    "minimatch": "11.0.9"
  }
}
